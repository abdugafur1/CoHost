{
  "name": "react-start",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --ui",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cohost \"npm run test:rules:emulator\"",
    "test:rules:emulator": "vitest run src/services/firestoreRules.emulator.test.ts && vitest run src/services/firestoreCompatibility.emulator.test.ts && vitest run src/services/cleanLaunch.emulator.test.ts",
    "coverage": "vitest run --coverage",
    "test:migration": "node --test scripts/migrate-publication.nodecheck.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
